# Reproducible source inputs for the validated Cubie A5E build.
# This file is sourced by build-cubie-a5e.sh.

LINUX_REPOSITORY="${LINUX_REPOSITORY:-https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux-stable.git}"
LINUX_REF="${LINUX_REF:-v6.18.45}"
LINUX_EXPECTED_COMMIT="${LINUX_EXPECTED_COMMIT:-bf3be28f6721e24961992ebb9e61c0cf21a56806}"

BSP_REPOSITORY="${BSP_REPOSITORY:-https://github.com/radxa/allwinner-bsp.git}"
BSP_REF="${BSP_REF:-cubie-aiot-v1.4.6}"
BSP_EXPECTED_COMMIT="${BSP_EXPECTED_COMMIT:-2045a3ca2a01f088c0314dc924bda59d154e363e}"

AIC_REPOSITORY="${AIC_REPOSITORY:-https://github.com/radxa-pkg/aic8800.git}"
AIC_REF="${AIC_REF:-5.0+git20260123.5f7be68d-7}"
AIC_EXPECTED_COMMIT="${AIC_EXPECTED_COMMIT:-6e076049b719ac2ff7ce5c92786a680407b11cdb}"

STOCK_IMAGE_URL="${STOCK_IMAGE_URL:-https://github.com/radxa-build/radxa-cubie-a5e/releases/download/rsdk-r7/radxa-cubie-a5e_bullseye_cli_r7.output_512.img.xz}"
STOCK_IMAGE_SHA512="${STOCK_IMAGE_SHA512:-7fe2890166ac5a2ac04dd3cd7a36b28c610e487553c6f93f154f0526a4ab7e9f54beeb6ca85825542d9e44f90fe708dea0470f7693049e1bfd082bb24b089a44}"

# Official Radxa AW2501 U-Boot maintenance payload used by rsetup for Cubie A5E.
# 2018.07-17 is the board-tested release that successfully hands the current
# managed kernel off from SPI U-Boot to an NVMe-root boot on the Cubie A5E.
# Revalidate this boot chain on hardware when promoting a new managed kernel.
RADXA_UBOOT_VERSION="${RADXA_UBOOT_VERSION:-2018.07-17}"
RADXA_UBOOT_RELEASE_BASE="${RADXA_UBOOT_RELEASE_BASE:-https://github.com/radxa-pkg/u-boot-aw2501/releases/download/${RADXA_UBOOT_VERSION}}"
RADXA_UBOOT_COMMON_URL="${RADXA_UBOOT_COMMON_URL:-${RADXA_UBOOT_RELEASE_BASE}/u-boot-aw2501_${RADXA_UBOOT_VERSION}_all.deb}"
RADXA_UBOOT_BOARD_URL="${RADXA_UBOOT_BOARD_URL:-${RADXA_UBOOT_RELEASE_BASE}/u-boot-radxa-cubie-a5e_${RADXA_UBOOT_VERSION}_all.deb}"

# SHA-256 pins for the official Radxa 2018.07-17 release assets.
# Stage 60 rejects the packages if these do not match.
RADXA_UBOOT_COMMON_SHA256="${RADXA_UBOOT_COMMON_SHA256:-84cd88576d0a0e1f1347cbf473251ee1fd51164e44f2c3a1f8e57fbf4a72ba89}"
RADXA_UBOOT_BOARD_SHA256="${RADXA_UBOOT_BOARD_SHA256:-0a1298ba8f48f11b15054c2d7402eeda86b485805220523ae6b851656e35ee5f}"
