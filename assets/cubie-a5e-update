#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 022

readonly PROGRAM_NAME="cubie-a5e-update"
readonly UPDATER_VERSION="1"
readonly BOARD_ID="radxa-cubie-a5e"
readonly CONFIG_DIR="/etc/cubie-a5e-update"
readonly LAYOUT_FILE="$CONFIG_DIR/layout.env"
readonly TRUSTED_KEY="$CONFIG_DIR/trusted-public.pem"
readonly STATE_DIR="/var/lib/cubie-a5e-update"
readonly STATE_FILE="$STATE_DIR/active.env"
readonly PENDING_FILE="$STATE_DIR/pending.env"
readonly INBOX_DIR="$STATE_DIR/inbox"
readonly ROLLBACK_FIRMWARE_DIR="$STATE_DIR/rollback-firmware"
readonly LOG_DIR="/var/log/cubie-a5e-update"
readonly LOCK_FILE="/run/lock/cubie-a5e-update.lock"
readonly MANAGED_LABEL="cubie-a5e"
readonly PREVIOUS_LABEL="cubie-a5e-previous"

BOOT_MOUNT=""
BOOT_MOUNT_OWNED=0
ROOT_UUID=""
BOOT_UUID=""
EXTLINUX_REL=""
SAME_FS=""
ACTIVE_KERNEL_RELEASE=""
ACTIVE_UPDATE_VERSION=""
TRANSACTION_NEW_KERNEL=""
TRANSACTION_SWITCHED=0
TRANSACTION_WORK_DIR=""

timestamp() {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
}

log() {
    printf '[%s] %s\n' "$(timestamp)" "$*"
}

warn() {
    printf '[%s] WARNING: %s\n' "$(timestamp)" "$*" >&2
}

die() {
    printf '[%s] ERROR: %s\n' "$(timestamp)" "$*" >&2
    exit 1
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 ||
        die "Required command not found: $1"
}

need_file() {
    [[ -s "$1" ]] || die "Required file is missing or empty: $1"
}

validate_simple_value() {
    local name="$1"
    local value="$2"

    [[ "$value" =~ ^[A-Za-z0-9._+:-]+$ ]] ||
        die "Invalid $name value: $value"
}

manifest_value() {
    local key="$1"
    local manifest="$2"

    awk -F= -v wanted="$key" '
        $1 == wanted {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "$manifest"
}

load_layout() {
    need_file "$LAYOUT_FILE"

    # This file is generated by the image builder and is root-owned.
    # shellcheck disable=SC1090
    source "$LAYOUT_FILE"

    [[ -n "$ROOT_UUID" ]] || die "ROOT_UUID is missing from $LAYOUT_FILE"
    [[ -n "$BOOT_UUID" ]] || die "BOOT_UUID is missing from $LAYOUT_FILE"
    [[ -n "$EXTLINUX_REL" ]] || die "EXTLINUX_REL is missing from $LAYOUT_FILE"

    case "$SAME_FS" in
        0 | 1) ;;
        *) die "SAME_FS must be 0 or 1 in $LAYOUT_FILE" ;;
    esac

    case "$EXTLINUX_REL" in
        boot/extlinux/extlinux.conf | extlinux/extlinux.conf) ;;
        *) die "Unsupported extlinux path: $EXTLINUX_REL" ;;
    esac
}

load_state() {
    if [[ -s "$STATE_FILE" ]]; then
        # This file is generated by this root-only updater.
        # shellcheck disable=SC1090
        source "$STATE_FILE"
    fi

    if [[ -z "$ACTIVE_KERNEL_RELEASE" ]]; then
        ACTIVE_KERNEL_RELEASE="$(uname -r)"
    fi

    if [[ -z "$ACTIVE_UPDATE_VERSION" ]]; then
        ACTIVE_UPDATE_VERSION="$ACTIVE_KERNEL_RELEASE"
    fi

    validate_simple_value "active kernel release" "$ACTIVE_KERNEL_RELEASE"
    validate_simple_value "active update version" "$ACTIVE_UPDATE_VERSION"
}

write_state() {
    local kernel_release="$1"
    local update_version="$2"
    local temporary

    validate_simple_value "kernel release" "$kernel_release"
    validate_simple_value "update version" "$update_version"

    install -d -m 0755 -- "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/.active.env.XXXXXX")"

    {
        printf 'ACTIVE_KERNEL_RELEASE=%q\n' "$kernel_release"
        printf 'ACTIVE_UPDATE_VERSION=%q\n' "$update_version"
        printf 'UPDATED_UTC=%q\n' "$(timestamp)"
    } >"$temporary"

    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$STATE_FILE"

    ACTIVE_KERNEL_RELEASE="$kernel_release"
    ACTIVE_UPDATE_VERSION="$update_version"
}

mount_boot_filesystem() {
    local existing_mount=""
    local mount_dir

    if [[ "$SAME_FS" == "1" ]]; then
        BOOT_MOUNT="/"
        return 0
    fi

    existing_mount="$(
        findmnt -rn -S "UUID=$BOOT_UUID" -o TARGET 2>/dev/null |
            head -n 1
    )"

    if [[ -n "$existing_mount" ]]; then
        BOOT_MOUNT="$existing_mount"
        return 0
    fi

    mount_dir="/run/cubie-a5e-update/boot"
    install -d -m 0755 -- "$mount_dir"
    mount -U "$BOOT_UUID" "$mount_dir"
    BOOT_MOUNT="$mount_dir"
    BOOT_MOUNT_OWNED=1
}

unmount_boot_filesystem() {
    if ((BOOT_MOUNT_OWNED == 1)) && mountpoint -q "$BOOT_MOUNT"; then
        umount "$BOOT_MOUNT"
    fi

    BOOT_MOUNT=""
    BOOT_MOUNT_OWNED=0
}

cleanup() {
    local status="$?"

    set +e

    if ((status != 0)) &&
       [[ -n "$TRANSACTION_NEW_KERNEL" ]] &&
       ((TRANSACTION_SWITCHED == 0)); then
        warn "Removing incomplete kernel payload: $TRANSACTION_NEW_KERNEL"
        if [[ "$SAME_FS" == "0" && -n "$BOOT_MOUNT" ]]; then
            rm -rf -- "$BOOT_MOUNT/dtb-$TRANSACTION_NEW_KERNEL"
            rm -f -- \
                "$BOOT_MOUNT/vmlinuz-$TRANSACTION_NEW_KERNEL" \
                "$BOOT_MOUNT/initrd.img-$TRANSACTION_NEW_KERNEL"
        fi
        rm -rf -- \
            "/lib/modules/$TRANSACTION_NEW_KERNEL" \
            "/usr/lib/linux-image-$TRANSACTION_NEW_KERNEL"
        rm -f -- \
            "/boot/vmlinuz-$TRANSACTION_NEW_KERNEL" \
            "/boot/config-$TRANSACTION_NEW_KERNEL" \
            "/boot/initrd.img-$TRANSACTION_NEW_KERNEL" \
            "/boot/System.map-$TRANSACTION_NEW_KERNEL"
        rm -f -- "$PENDING_FILE"
        restore_rollback_firmware
    fi

    if [[ "$TRANSACTION_WORK_DIR" == /var/tmp/cubie-a5e-update.* &&
          -d "$TRANSACTION_WORK_DIR" ]]; then
        rm -rf -- "$TRANSACTION_WORK_DIR"
    fi

    unmount_boot_filesystem
}

trap cleanup EXIT

acquire_lock() {
    install -d -m 0755 -- "$(dirname -- "$LOCK_FILE")"
    exec 8>"$LOCK_FILE"
    flock -n 8 || die "Another Cubie A5E update is already running."
}

extlinux_file() {
    printf '%s/%s\n' "${BOOT_MOUNT%/}" "$EXTLINUX_REL"
}

kernel_paths() {
    local kernel_release="$1"

    if [[ "$SAME_FS" == "1" ]]; then
        printf '%s\n' \
            "/boot/vmlinuz-$kernel_release" \
            "/boot/initrd.img-$kernel_release" \
            "/usr/lib/linux-image-$kernel_release/"
    else
        printf '%s\n' \
            "/vmlinuz-$kernel_release" \
            "/initrd.img-$kernel_release" \
            "/dtb-$kernel_release/"
    fi
}

current_append_line() {
    local extlinux
    local append_line

    extlinux="$(extlinux_file)"
    need_file "$extlinux"

    append_line="$(
        awk -v label="$MANAGED_LABEL" '
            $1 == "label" && $2 == label {
                inside = 1
                next
            }

            inside && $1 == "label" {
                exit
            }

            inside && $1 == "append" {
                sub(/^[[:space:]]*append[[:space:]]+/, "")
                print
                exit
            }
        ' "$extlinux"
    )"

    if [[ -z "$append_line" ]]; then
        append_line="$(
            awk '
                $1 == "append" {
                    sub(/^[[:space:]]*append[[:space:]]+/, "")
                    print
                    exit
                }
            ' "$extlinux"
        )"
    fi

    if [[ -z "$append_line" ]]; then
        append_line="root=UUID=$ROOT_UUID rootwait rw console=tty1"
    elif grep -qE '(^|[[:space:]])root=UUID=[^[:space:]]+' <<<"$append_line"; then
        append_line="$(
            sed -E \
                "s#(^|[[:space:]])root=UUID=[^[:space:]]+#\\1root=UUID=$ROOT_UUID#" \
                <<<"$append_line"
        )"
    else
        append_line="root=UUID=$ROOT_UUID $append_line"
    fi

    printf '%s\n' "$append_line"
}

write_extlinux() {
    local current_kernel="$1"
    local previous_kernel="${2:-}"
    local extlinux
    local extlinux_dir
    local temporary
    local append_line
    local current_linux
    local current_initrd
    local current_fdtdir
    local previous_linux=""
    local previous_initrd=""
    local previous_fdtdir=""
    local -a current_paths=()
    local -a previous_paths=()

    extlinux="$(extlinux_file)"
    extlinux_dir="$(dirname -- "$extlinux")"
    install -d -m 0755 -- "$extlinux_dir"
    append_line="$(current_append_line)"

    mapfile -t current_paths < <(kernel_paths "$current_kernel")
    current_linux="${current_paths[0]}"
    current_initrd="${current_paths[1]}"
    current_fdtdir="${current_paths[2]}"

    if [[ -n "$previous_kernel" ]]; then
        mapfile -t previous_paths < <(kernel_paths "$previous_kernel")
        previous_linux="${previous_paths[0]}"
        previous_initrd="${previous_paths[1]}"
        previous_fdtdir="${previous_paths[2]}"
    fi

    temporary="$(mktemp "$extlinux_dir/.extlinux.conf.XXXXXX")"

    {
        printf 'default %s\n' "$MANAGED_LABEL"
        printf 'menu title Radxa Cubie A5E\n'
        printf 'timeout %s\n\n' "$([[ -n "$previous_kernel" ]] && printf 50 || printf 10)"
        printf 'label %s\n' "$MANAGED_LABEL"
        printf 'menu label Debian GNU/Linux 13 Linux %s\n' "$current_kernel"
        printf 'linux %s\n' "$current_linux"
        printf 'initrd %s\n' "$current_initrd"
        printf 'fdtdir %s\n' "$current_fdtdir"
        printf 'append %s\n' "$append_line"

        if [[ -n "$previous_kernel" ]]; then
            printf '\nlabel %s\n' "$PREVIOUS_LABEL"
            printf 'menu label Roll back to Linux %s\n' "$previous_kernel"
            printf 'linux %s\n' "$previous_linux"
            printf 'initrd %s\n' "$previous_initrd"
            printf 'fdtdir %s\n' "$previous_fdtdir"
            printf 'append %s\n' "$append_line"
        fi
    } >"$temporary"

    chmod 0644 "$temporary"
    sync "$temporary"
    mv -f -- "$temporary" "$extlinux"
    sync "$extlinux"

    grep -Fxq "default $MANAGED_LABEL" "$extlinux" ||
        die "Failed to set the managed extlinux default."
    grep -Fxq "linux $current_linux" "$extlinux" ||
        die "Managed kernel path is missing from extlinux."
}

copy_kernel_to_boot() {
    local kernel_release="$1"

    if [[ "$SAME_FS" == "1" ]]; then
        return 0
    fi

    install -D -m 0644 \
        "/boot/vmlinuz-$kernel_release" \
        "$BOOT_MOUNT/vmlinuz-$kernel_release"
    install -D -m 0644 \
        "/boot/initrd.img-$kernel_release" \
        "$BOOT_MOUNT/initrd.img-$kernel_release"
    install -D -m 0644 \
        "/usr/lib/linux-image-$kernel_release/allwinner/sun55i-a527-cubie-a5e.dtb" \
        "$BOOT_MOUNT/dtb-$kernel_release/allwinner/sun55i-a527-cubie-a5e.dtb"
}

remove_kernel_payload() {
    local kernel_release="$1"

    [[ -n "$kernel_release" ]] || return 0
    validate_simple_value "kernel release" "$kernel_release"

    rm -rf -- \
        "/lib/modules/$kernel_release" \
        "/usr/lib/linux-image-$kernel_release"
    rm -f -- \
        "/boot/vmlinuz-$kernel_release" \
        "/boot/config-$kernel_release" \
        "/boot/initrd.img-$kernel_release" \
        "/boot/System.map-$kernel_release"

    if [[ "$SAME_FS" == "0" && -n "$BOOT_MOUNT" ]]; then
        rm -rf -- "$BOOT_MOUNT/dtb-$kernel_release"
        rm -f -- \
            "$BOOT_MOUNT/vmlinuz-$kernel_release" \
            "$BOOT_MOUNT/initrd.img-$kernel_release"
    fi
}

prune_to_kernel() {
    local keep_kernel="$1"
    local candidate
    local candidate_release

    for candidate in /lib/modules/*; do
        [[ -d "$candidate" ]] || continue
        candidate_release="$(basename -- "$candidate")"
        [[ "$candidate_release" == "$keep_kernel" ]] ||
            remove_kernel_payload "$candidate_release"
    done

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        candidate_release="${candidate##*/linux-image-}"
        [[ "$candidate_release" == "$keep_kernel" ]] ||
            remove_kernel_payload "$candidate_release"
    done < <(
        find /usr/lib \
            -maxdepth 1 \
            -type d \
            -name 'linux-image-*' \
            -print
    )

    if [[ "$SAME_FS" == "0" ]]; then
        while IFS= read -r candidate; do
            [[ -n "$candidate" ]] || continue
            candidate_release="${candidate##*/dtb-}"
            [[ "$candidate_release" == "$keep_kernel" ]] ||
                remove_kernel_payload "$candidate_release"
        done < <(
            find "$BOOT_MOUNT" \
                -maxdepth 1 \
                -type d \
                -name 'dtb-*' \
                -print
        )
    fi
}

backup_rollback_firmware() {
    local installed="/lib/firmware/aic8800_fw/SDIO/aic8800D80"
    local temporary

    rm -rf -- "$ROLLBACK_FIRMWARE_DIR"
    install -d -m 0755 -- "$STATE_DIR"
    temporary="$(mktemp -d "$STATE_DIR/.rollback-firmware.XXXXXX")"

    if [[ -d "$installed" ]]; then
        if ! cp -a -- "$installed" "$temporary/"; then
            rm -rf -- "$temporary"
            die "Could not preserve the active AIC8800 firmware."
        fi
    else
        : >"$temporary/.was-absent"
    fi

    chmod 0700 "$temporary"
    mv -f -- "$temporary" "$ROLLBACK_FIRMWARE_DIR"
}

restore_rollback_firmware() {
    local installed="/lib/firmware/aic8800_fw/SDIO/aic8800D80"
    local saved="$ROLLBACK_FIRMWARE_DIR/aic8800D80"
    local parent
    local temporary

    [[ -d "$ROLLBACK_FIRMWARE_DIR" ]] || return 0

    if [[ -d "$saved" ]]; then
        parent="$(dirname -- "$installed")"
        install -d -m 0755 -- "$parent"
        temporary="$(mktemp -d "$parent/.rollback-firmware.XXXXXX")"

        if ! cp -a -- "$saved/." "$temporary/"; then
            rm -rf -- "$temporary"
            warn "Could not stage the rollback AIC8800 firmware."
            return 1
        fi

        chmod 0755 "$temporary"
        rm -rf -- "$installed"
        mv -f -- "$temporary" "$installed"
    else
        rm -rf -- "$installed"
    fi

    rm -rf -- "$ROLLBACK_FIRMWARE_DIR"
}

archive_is_safe() {
    local bundle="$1"
    local entry
    local normalized

    while IFS= read -r entry; do
        normalized="${entry#./}"

        [[ -n "$normalized" ]] || continue

        case "$normalized" in
            /* | ../* | */../* | */..)
                return 1
                ;;
        esac
    done < <(tar -tzf "$bundle")

    if tar -tvzf "$bundle" |
        awk 'substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d" { found = 1 } END { exit found ? 0 : 1 }'; then
        return 1
    fi

    return 0
}

validate_bundle() {
    local bundle="$1"
    local extracted="$2"
    local manifest="$extracted/manifest.env"
    local sums="$extracted/SHA256SUMS"
    local signature="$extracted/SHA256SUMS.sig"
    local format_version
    local board
    local update_type
    local update_version
    local kernel_release
    local minimum_updater
    local firmware_name
    local module
    local vermagic

    [[ -f "$bundle" ]] || die "Update bundle not found: $bundle"
    need_file "$TRUSTED_KEY"

    archive_is_safe "$bundle" ||
        die "Update bundle contains unsafe archive entries."

    tar -xzf "$bundle" \
        --no-same-owner \
        --no-same-permissions \
        -C "$extracted"

    if find "$extracted" -type l -print -quit | grep -q .; then
        die "Update bundle must not contain symbolic links."
    fi

    need_file "$manifest"
    need_file "$sums"
    need_file "$signature"

    openssl dgst \
        -sha256 \
        -verify "$TRUSTED_KEY" \
        -signature "$signature" \
        "$sums" >/dev/null ||
        die "Update bundle signature verification failed."

    (
        cd "$extracted"
        sha256sum -c SHA256SUMS >/dev/null
    ) || die "Update bundle checksum verification failed."

    format_version="$(manifest_value FORMAT_VERSION "$manifest")"
    board="$(manifest_value BOARD_ID "$manifest")"
    update_type="$(manifest_value UPDATE_TYPE "$manifest")"
    update_version="$(manifest_value UPDATE_VERSION "$manifest")"
    kernel_release="$(manifest_value KERNEL_RELEASE "$manifest")"
    minimum_updater="$(manifest_value MIN_UPDATER_VERSION "$manifest")"

    [[ "$format_version" == "1" ]] ||
        die "Unsupported update bundle format: $format_version"
    [[ "$board" == "$BOARD_ID" ]] ||
        die "Bundle is for $board, not $BOARD_ID"
    [[ "$update_type" == "kernel" ]] ||
        die "Unsupported update type: $update_type"

    validate_simple_value "update version" "$update_version"
    validate_simple_value "kernel release" "$kernel_release"

    [[ "$minimum_updater" =~ ^[0-9]+$ ]] ||
        die "Invalid minimum updater version: $minimum_updater"
    ((UPDATER_VERSION >= minimum_updater)) ||
        die "Bundle requires updater version $minimum_updater or newer."

    [[ "$kernel_release" != "$ACTIVE_KERNEL_RELEASE" ]] ||
        die "Refusing an in-place replacement of running release $kernel_release. Use a unique kernel release."
    dpkg --compare-versions "$kernel_release" gt "$ACTIVE_KERNEL_RELEASE" ||
        die "Refusing non-newer kernel release $kernel_release; active release is $ACTIVE_KERNEL_RELEASE."

    need_file "$extracted/payload/rootfs/boot/vmlinuz-$kernel_release"
    need_file "$extracted/payload/rootfs/boot/config-$kernel_release"
    need_file \
        "$extracted/payload/rootfs/usr/lib/linux-image-$kernel_release/allwinner/sun55i-a527-cubie-a5e.dtb"
    [[ -d "$extracted/payload/rootfs/lib/modules/$kernel_release" ]] ||
        die "Bundle module tree is missing for $kernel_release"

    for firmware_name in \
        fw_patch_table_8800d80_u02.bin \
        fw_adid_8800d80_u02.bin \
        fw_patch_8800d80_u02.bin \
        fmacfw_8800d80_u02.bin; do
        need_file \
            "$extracted/payload/rootfs/lib/firmware/aic8800_fw/SDIO/aic8800D80/$firmware_name"
    done

    for module in \
        "$extracted/payload/rootfs/lib/modules/$kernel_release/updates/aic8800/aic8800_bsp.ko" \
        "$extracted/payload/rootfs/lib/modules/$kernel_release/updates/aic8800/aic8800_fdrv.ko"; do
        need_file "$module"
        vermagic="$(modinfo -F vermagic "$module" | awk '{print $1}')"
        [[ "$vermagic" == "$kernel_release" ]] ||
            die "Module vermagic mismatch: $module=$vermagic expected=$kernel_release"
    done

    printf '%s\t%s\n' "$update_version" "$kernel_release"
}

write_pending_state() {
    local old_kernel="$1"
    local old_version="$2"
    local new_kernel="$3"
    local new_version="$4"
    local temporary

    temporary="$(mktemp "$STATE_DIR/.pending.env.XXXXXX")"

    {
        printf 'OLD_KERNEL_RELEASE=%q\n' "$old_kernel"
        printf 'OLD_UPDATE_VERSION=%q\n' "$old_version"
        printf 'NEW_KERNEL_RELEASE=%q\n' "$new_kernel"
        printf 'NEW_UPDATE_VERSION=%q\n' "$new_version"
        printf 'INSTALLED_UTC=%q\n' "$(timestamp)"
    } >"$temporary"

    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$PENDING_FILE"
}

install_bundle() {
    local bundle="$1"
    local work_dir
    local extracted
    local validation
    local update_version
    local kernel_release
    local log_file

    [[ ! -e "$PENDING_FILE" ]] ||
        die "A kernel update is already pending boot finalization."

    work_dir="$(mktemp -d -p /var/tmp cubie-a5e-update.XXXXXX)"
    TRANSACTION_WORK_DIR="$work_dir"
    extracted="$work_dir/extracted"
    install -d -m 0700 -- "$extracted"

    validation="$(validate_bundle "$bundle" "$extracted")"
    IFS=$'\t' read -r update_version kernel_release <<<"$validation"

    [[ -n "$update_version" && -n "$kernel_release" ]] ||
        die "Validated bundle did not return version metadata."

    install -d -m 0755 -- "$LOG_DIR" "$STATE_DIR"
    log_file="$LOG_DIR/install-$(date -u '+%Y%m%dT%H%M%SZ').log"
    exec > >(tee -a "$log_file") 2>&1

    log "Installing signed kernel update $update_version"
    log "New kernel release: $kernel_release"
    log "Rollback kernel release: $ACTIVE_KERNEL_RELEASE"

    TRANSACTION_NEW_KERNEL="$kernel_release"
    TRANSACTION_SWITCHED=0

    backup_rollback_firmware

    rsync -a \
        "$extracted/payload/rootfs/" \
        /

    rm -rf -- "/lib/firmware/aic8800_fw/SDIO/aic8800D80"
    install -d -m 0755 -- "/lib/firmware/aic8800_fw/SDIO/aic8800D80"
    rsync -a \
        "$extracted/payload/rootfs/lib/firmware/aic8800_fw/SDIO/aic8800D80/" \
        "/lib/firmware/aic8800_fw/SDIO/aic8800D80/"

    depmod "$kernel_release"
    update-initramfs -c -k "$kernel_release"

    need_file "/boot/initrd.img-$kernel_release"

    mount_boot_filesystem
    copy_kernel_to_boot "$kernel_release"

    write_pending_state \
        "$ACTIVE_KERNEL_RELEASE" \
        "$ACTIVE_UPDATE_VERSION" \
        "$kernel_release" \
        "$update_version"

    write_extlinux "$kernel_release" "$ACTIVE_KERNEL_RELEASE"
    TRANSACTION_SWITCHED=1

    sync

    log "Kernel update installed and set as the next boot default."
    log "The previous kernel is temporarily available as: $PREVIOUS_LABEL"
    log "Reboot now. Successful boot finalization will remove the previous kernel."
    log "Install log: $log_file"

    TRANSACTION_NEW_KERNEL=""
    rm -rf -- "$work_dir"
    TRANSACTION_WORK_DIR=""
}

finalize_boot() {
    local running_kernel
    local old_kernel
    local old_version
    local new_kernel
    local new_version

    [[ -s "$PENDING_FILE" ]] || return 0

    # This file is generated by this root-only updater.
    # shellcheck disable=SC1090
    source "$PENDING_FILE"

    old_kernel="${OLD_KERNEL_RELEASE:-}"
    old_version="${OLD_UPDATE_VERSION:-}"
    new_kernel="${NEW_KERNEL_RELEASE:-}"
    new_version="${NEW_UPDATE_VERSION:-}"

    validate_simple_value "old kernel release" "$old_kernel"
    validate_simple_value "old update version" "$old_version"
    validate_simple_value "new kernel release" "$new_kernel"
    validate_simple_value "new update version" "$new_version"

    running_kernel="$(uname -r)"
    mount_boot_filesystem

    if [[ "$running_kernel" == "$new_kernel" ]]; then
        log "Finalizing successful boot into Linux $new_kernel."
        write_extlinux "$new_kernel"
        prune_to_kernel "$new_kernel"
        write_state "$new_kernel" "$new_version"
        rm -f -- "$PENDING_FILE"
        rm -rf -- "$ROLLBACK_FIRMWARE_DIR"
        sync
        log "Previous kernel removed. Linux $new_kernel is the only managed kernel."
    elif [[ "$running_kernel" == "$old_kernel" ]]; then
        warn "Rollback kernel $old_kernel was selected."
        write_extlinux "$old_kernel"
        restore_rollback_firmware
        remove_kernel_payload "$new_kernel"
        prune_to_kernel "$old_kernel"
        write_state "$old_kernel" "$old_version"
        rm -f -- "$PENDING_FILE"
        sync
        warn "Failed kernel $new_kernel was removed and rollback was finalized."
    else
        die "Running kernel $running_kernel matches neither pending kernel."
    fi
}

show_status() {
    local pending="no"
    local key_fingerprint

    [[ -s "$PENDING_FILE" ]] && pending="yes"

    key_fingerprint="$(
        openssl pkey \
            -pubin \
            -in "$TRUSTED_KEY" \
            -outform DER 2>/dev/null |
            sha256sum |
            awk '{print $1}'
    )"

    printf 'Radxa Cubie A5E update status\n'
    printf '================================\n'
    printf 'Updater version: %s\n' "$UPDATER_VERSION"
    printf 'Running kernel: %s\n' "$(uname -r)"
    printf 'Managed kernel: %s\n' "$ACTIVE_KERNEL_RELEASE"
    printf 'Managed update version: %s\n' "$ACTIVE_UPDATE_VERSION"
    printf 'Pending boot finalization: %s\n' "$pending"
    printf 'Trusted key SHA256: %s\n' "$key_fingerprint"
    printf 'Bundle inbox: %s\n' "$INBOX_DIR"
}

tui_install_bundle() {
    local bundle

    bundle="$(
        whiptail \
            --title "Cubie A5E Updates" \
            --inputbox "Enter the full path to a signed update bundle:" \
            10 \
            78 \
            "$INBOX_DIR/" \
            3>&1 \
            1>&2 \
            2>&3
    )" || return 0

    [[ -n "$bundle" ]] || return 0

    if whiptail \
        --title "Confirm Kernel Update" \
        --yesno "Install this signed update?\n\n$bundle\n\nThe previous kernel remains temporarily available until the new kernel boots successfully." \
        14 \
        78; then
        install_bundle "$bundle"
        whiptail \
            --title "Update Installed" \
            --msgbox "The new kernel is ready.\n\nReboot the board to complete the update." \
            10 \
            70
    fi
}

run_tui() {
    local choice
    local status_text

    while true; do
        choice="$(
            whiptail \
                --title "Radxa Cubie A5E Updates" \
                --menu "Signed kernel and board-support updates" \
                18 \
                76 \
                8 \
                "status" "Show current update status" \
                "install" "Install a signed update bundle" \
                "exit" "Return to rsetup" \
                3>&1 \
                1>&2 \
                2>&3
        )" || return 0

        case "$choice" in
            status)
                status_text="$(show_status)"
                whiptail \
                    --title "Cubie A5E Update Status" \
                    --msgbox "$status_text" \
                    18 \
                    78
                ;;
            install)
                tui_install_bundle
                ;;
            exit)
                return 0
                ;;
        esac
    done
}

usage() {
    printf 'Usage:\n'
    printf '  %s --status\n' "$PROGRAM_NAME"
    printf '  %s --install BUNDLE.tar.gz\n' "$PROGRAM_NAME"
    printf '  %s --finalize-boot\n' "$PROGRAM_NAME"
    printf '  %s --tui\n' "$PROGRAM_NAME"
}

main() {
    local command_name

    for command_name in \
        awk \
        depmod \
        dpkg \
        find \
        findmnt \
        flock \
        grep \
        head \
        install \
        mktemp \
        modinfo \
        mount \
        mountpoint \
        mv \
        openssl \
        rsync \
        sed \
        sha256sum \
        sync \
        tar \
        tee \
        umount \
        uname \
        update-initramfs; do
        need_cmd "$command_name"
    done

    [[ "$(id -u)" -eq 0 ]] ||
        die "Run $PROGRAM_NAME through sudo or as root."

    need_file "$TRUSTED_KEY"
    load_layout
    load_state
    install -d -m 0755 -- "$STATE_DIR" "$INBOX_DIR"
    acquire_lock

    case "${1:-}" in
        --status)
            show_status
            ;;
        --install)
            [[ -n "${2:-}" ]] || die "--install requires a bundle path."
            install_bundle "$2"
            ;;
        --finalize-boot)
            finalize_boot
            ;;
        --tui | "")
            need_cmd whiptail
            run_tui
            ;;
        --help | -h)
            usage
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
