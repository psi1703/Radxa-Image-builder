#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

readonly RADXA_RSETUP="/usr/bin/rsetup"
readonly CUBIE_UPDATE="/usr/local/sbin/cubie-a5e-update"
readonly CUBIE_NVME_INSTALL="/usr/local/sbin/cubie-a5e-install-nvme"
readonly CUBIE_APT_CHANNEL_STATE="/etc/cubie-a5e-update/apt-channel.env"
readonly CUBIE_UPDATE_PENDING="/var/lib/cubie-a5e-update/pending.env"

rsetup_self_test() {
    local command_name
    local required_commands=(
        apt-get
        dtc
        jq
        nmcli
        parted
        python3
        rfkill
        sgdisk
        sudo
        u-boot-update
        whiptail
    )
    local required_files=(
        "$RADXA_RSETUP"
        "$CUBIE_NVME_INSTALL"
        /usr/lib/librtui/tui.sh
        /usr/lib/librtui/utils/utils.sh
        /usr/lib/rsetup/cli/main.sh
        /usr/lib/rsetup/tui/main.sh
        /usr/lib/rsetup/tui/system/system.sh
        /usr/lib/rsetup/tui/comm/comm.sh
        /usr/lib/rsetup/tui/hardware/hardware.sh
        /usr/lib/rsetup/tui/overlay/overlay.sh
        /usr/lib/rsetup/tui/local/local.sh
        /usr/lib/rsetup/tui/task/task.sh
        /usr/lib/rsetup/tui/user/user.sh
    )
    local required_functions=(
        __tui_main
        __system
        __hardware
        __overlay
        __comm
        __user
        __local
        __task
        system_update
    )
    local function_name
    local required_file

    for required_file in "${required_files[@]}"; do
        [[ -s "$required_file" ]] || {
            printf 'rsetup self-test: missing file: %s\n' "$required_file" >&2
            return 1
        }
    done

    [[ -x "$RADXA_RSETUP" ]] || {
        printf 'rsetup self-test: not executable: %s\n' "$RADXA_RSETUP" >&2
        return 1
    }

    [[ -x "$CUBIE_NVME_INSTALL" ]] || {
        printf 'rsetup self-test: not executable: %s\n' "$CUBIE_NVME_INSTALL" >&2
        return 1
    }

    "$CUBIE_NVME_INSTALL" --self-test || return 1

    for command_name in "${required_commands[@]}"; do
        command -v "$command_name" >/dev/null 2>&1 || {
            printf 'rsetup self-test: missing command: %s\n' "$command_name" >&2
            return 1
        }
    done

    export DEBUG=false
    export LANG=C
    export LANGUAGE=C
    export LC_ALL=C

    # shellcheck disable=SC1091
    source /usr/lib/rsetup/cli/main.sh
    # shellcheck disable=SC1091
    source /usr/lib/rsetup/tui/main.sh

    for function_name in "${required_functions[@]}"; do
        declare -F "$function_name" >/dev/null || {
            printf 'rsetup self-test: missing function: %s\n' "$function_name" >&2
            return 1
        }
    done

    printf 'rsetup self-test: PASS\n'
}


run_full_system_upgrade() {
    local channel_configured="0"
    local repository_url=""
    local prompt

    if [[ -r "$CUBIE_APT_CHANNEL_STATE" ]]; then
        # Root-owned state generated by the image installer.
        # shellcheck disable=SC1090
        source "$CUBIE_APT_CHANNEL_STATE"
        channel_configured="${CONFIGURED:-0}"
        repository_url="${REPOSITORY_URL:-}"
    fi

    if [[ "$channel_configured" == "1" && -n "$repository_url" ]]; then
        prompt="Run apt-get update and apt-get full-upgrade?\n\nApproved Cubie A5E kernel/board packages from:\n$repository_url\n\nwill be included with normal Debian/Radxa package updates."
    else
        prompt="Run apt-get update and apt-get full-upgrade?\n\nThe Cubie A5E signed APT channel is not configured yet, so this will update normal Debian/Radxa packages only. The managed kernel remains protected from generic kernel replacement."
    fi

    whiptail \
        --title "Full System Upgrade" \
        --yesno "$prompt" \
        16 \
        78 || return 0

    clear 2>/dev/null || true
    printf '=== Cubie A5E full system upgrade ===\n'
    if [[ "$channel_configured" == "1" ]]; then
        printf 'Cubie update channel: %s\n' "$repository_url"
    else
        printf 'Cubie update channel: not configured\n'
    fi
    printf '\n'

    apt-get update
    apt-get full-upgrade

    printf '\n'
    if [[ -s "$CUBIE_UPDATE_PENDING" ]]; then
        printf 'A new managed Cubie A5E kernel was installed. Reboot to validate and finalize it.\n'
    else
        printf 'Package upgrade completed.\n'
    fi
    printf 'Press Enter to return to rsetup...'
    IFS= read -r _
}

case "${1:-}" in
    --self-test)
        (($# == 1)) || {
            printf 'Usage: rsetup --self-test\n' >&2
            exit 2
        }
        rsetup_self_test
        exit
        ;;
    "")
        ;;
    *)
        exec "$RADXA_RSETUP" "$@"
        ;;
esac

if ((EUID != 0)); then
    exec sudo "$0"
fi

while true; do
    choice="$(
        whiptail \
            --title "RSETUP" \
            --menu "Please select an option below:" \
            18 \
            78 \
            8 \
            "radxa" "Radxa system configuration and package updates" \
            "upgrade" "Full Debian/Radxa + approved Cubie A5E package upgrade" \
            "cubie" "Cubie A5E signed kernel and board updates" \
            "nvme" "Install the current Cubie A5E system to NVMe" \
            "exit" "Exit" \
            3>&1 \
            1>&2 \
            2>&3
    )" || exit 0

    case "$choice" in
        radxa)
            "$RADXA_RSETUP"
            ;;
        upgrade)
            run_full_system_upgrade
            ;;
        cubie)
            "$CUBIE_UPDATE" --tui
            ;;
        nvme)
            "$CUBIE_NVME_INSTALL" --tui
            ;;
        exit)
            exit 0
            ;;
    esac
done
