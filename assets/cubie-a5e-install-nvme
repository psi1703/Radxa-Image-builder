#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 022

readonly DEFAULT_TARGET="/usr/local/sbin/cubie-a5e-install-nvme"
TARGET="${1:-$DEFAULT_TARGET}"

log() {
    printf '[NVME-HOTFIX] %s\n' "$*"
}

die() {
    printf '[NVME-HOTFIX] ERROR: %s\n' "$*" >&2
    exit 1
}

if ((EUID != 0)); then
    command -v sudo >/dev/null 2>&1 || die "sudo is required."
    exec sudo "$0" "$@"
fi

[[ -f "$TARGET" ]] || die "Installer not found: $TARGET"
[[ ! -L "$TARGET" ]] || die "Refusing to patch symbolic link: $TARGET"

grep -Fq 'set -Eeuo pipefail' "$TARGET" || die "Target does not look like the guarded Cubie A5E NVMe installer."
grep -Fq 'expected_marker="U-Boot ${aw2501_version}-boot-aw2501-"' "$TARGET" || die "Expected SPI U-Boot validation block was not found."

if grep -Fq 'grep -Fq -- "$expected_marker"; then' "$TARGET"; then
    NEED_SPI_FIX=1
else
    NEED_SPI_FIX=0
fi

if grep -Fq "grep -Eq '^Attribute flags:" "$TARGET"; then
    NEED_GPT_FIX=1
else
    NEED_GPT_FIX=0
fi

if ((NEED_SPI_FIX == 0 && NEED_GPT_FIX == 0)); then
    log "No vulnerable pipefail/grep -q patterns remain in $TARGET."
    bash -n "$TARGET" || die "Installer syntax validation failed."
    log "Installer syntax: PASS"
    exit 0
fi

BACKUP="${TARGET}.pre-pipefail-fix.$(date -u '+%Y%m%dT%H%M%SZ')"
cp -a -- "$TARGET" "$BACKUP"
log "Backup created: $BACKUP"

if ((NEED_SPI_FIX == 1)); then
    sed -i \
        's/grep -Fq -- "$expected_marker"; then/grep -F -- "$expected_marker" >\/dev\/null; then/' \
        "$TARGET"
fi

if ((NEED_GPT_FIX == 1)); then
    sed -i \
        "/grep -Eq '\^Attribute flags:/ { s/grep -Eq /grep -E /; s/ ||$/ >\\/dev\\/null ||/; }" \
        "$TARGET"
fi

if grep -Fq 'grep -Fq -- "$expected_marker"; then' "$TARGET"; then
    cp -a -- "$BACKUP" "$TARGET"
    die "SPI validation fix did not apply; original installer restored."
fi

if grep -Fq "grep -Eq '^Attribute flags:" "$TARGET"; then
    cp -a -- "$BACKUP" "$TARGET"
    die "GPT attribute validation fix did not apply; original installer restored."
fi

bash -n "$TARGET" || {
    cp -a -- "$BACKUP" "$TARGET"
    die "Patched installer failed bash syntax validation; original installer restored."
}

chmod 0755 "$TARGET"
log "Patched installer: $TARGET"
log "SPI marker check no longer uses grep -q in a streaming pipeline."
log "GPT attribute check no longer uses grep -q in a streaming pipeline."
log "Installer syntax: PASS"
log "Now rerun: sudo $TARGET --tui"
