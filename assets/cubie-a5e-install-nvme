#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 022

readonly PROGRAM_NAME="cubie-a5e-install-nvme"
readonly LAYOUT_FILE="/etc/cubie-a5e-update/layout.env"
readonly LOCK_FILE="/run/lock/cubie-a5e-install-nvme.lock"
readonly UPDATE_LOCK_FILE="/run/lock/cubie-a5e-update.lock"
readonly WORK_DIR="/run/cubie-a5e-install-nvme"
readonly TARGET_ROOT_MNT="$WORK_DIR/root"
readonly STATUS_FILE_REL="/var/lib/cubie-a5e/nvme-install.status"
readonly ROOT_GROW_MARKER_REL="/var/lib/cubie-a5e/rootfs-expanded"
readonly EXPECTED_EXTLINUX_REL="boot/extlinux/extlinux.conf"
readonly EXPECTED_SPI_FREQUENCY="20000000"
readonly SPI_MTD_DEVICE="/dev/mtd0"
readonly RADXA_UBOOT_PAYLOAD_DIR="/usr/lib/u-boot/radxa-cubie-a5e"
readonly MINIMUM_UBOOT_VERSION="2018.07-17"

TUI_MODE=0
REQUESTED_TARGET=""
SOURCE_ROOT_PART=""
SOURCE_DISK=""
SOURCE_ROOT_UUID=""
SOURCE_ROOT_START_SECTOR=""
SOURCE_ROOT_START_BYTES=""
SOURCE_DISK_SIZE=""
SOURCE_SECTOR_SIZE=""
TARGET_DISK=""
TARGET_ROOT_PART=""
TARGET_ROOT_UUID=""
TARGET_DISK_SIZE=""
TARGET_SECTOR_SIZE=""
ROOT_UUID=""
BOOT_UUID=""
EXTLINUX_REL=""
SAME_FS=""
TARGET_ROOT_MOUNTED=0

log() {
    printf '[NVME] %s\n' "$*"
}

warn() {
    printf '[NVME] WARNING: %s\n' "$*" >&2
}

die() {
    printf '[NVME] ERROR: %s\n' "$*" >&2
    exit 1
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

usage() {
    cat <<'USAGE'
Usage:
  cubie-a5e-install-nvme --tui
  cubie-a5e-install-nvme --target /dev/nvmeXnY
  cubie-a5e-install-nvme --list-targets
  cubie-a5e-install-nvme --self-test

This installer copies the currently running managed Cubie A5E system from its
partition-3 source media to an NVMe namespace. The selected NVMe is erased.
Standalone NVMe boot also requires compatible Cubie A5E SPI boot firmware.
USAGE
}

cleanup() {
    set +e
    if ((TARGET_ROOT_MOUNTED == 1)) && mountpoint -q "$TARGET_ROOT_MNT"; then
        umount "$TARGET_ROOT_MNT"
    fi
    TARGET_ROOT_MOUNTED=0
    rm -rf -- "$WORK_DIR"
}

trap cleanup EXIT INT TERM

partition_path() {
    local disk="$1"
    local part_num="$2"

    [[ "$part_num" =~ ^[1-9][0-9]*$ ]] || die "Invalid partition number: $part_num"
    case "$disk" in
        /dev/nvme*n* | /dev/mmcblk* | /dev/loop*) printf '%sp%s\n' "$disk" "$part_num" ;;
        /dev/*) printf '%s%s\n' "$disk" "$part_num" ;;
        *) die "Invalid disk path: $disk" ;;
    esac
}

self_test() {
    local command_name
    local required_commands=(
        awk basename blkid blockdev chmod date dd dirname dpkg dpkg-query
        e2fsck fdtget findmnt flock grep head install lsblk mkfs.ext4 mktemp
        mount mountpoint mv parted partprobe readlink rm rsync sed sgdisk sort
        stat strings sudo swapon sync tr udevadm umount uname wc whiptail wipefs xargs
    )

    for command_name in "${required_commands[@]}"; do
        command -v "$command_name" >/dev/null 2>&1 || {
            printf '%s self-test: missing command: %s\n' "$PROGRAM_NAME" "$command_name" >&2
            return 1
        }
    done

    [[ -s "$LAYOUT_FILE" ]] || {
        printf '%s self-test: missing layout file: %s\n' "$PROGRAM_NAME" "$LAYOUT_FILE" >&2
        return 1
    }
    [[ -x "$RADXA_UBOOT_PAYLOAD_DIR/setup.sh" ]] || {
        printf '%s self-test: missing Radxa U-Boot backend: %s/setup.sh\n' "$PROGRAM_NAME" "$RADXA_UBOOT_PAYLOAD_DIR" >&2
        return 1
    }

    printf '%s self-test: PASS\n' "$PROGRAM_NAME"
}

load_managed_layout() {
    [[ -s "$LAYOUT_FILE" ]] || die "Managed image layout is missing: $LAYOUT_FILE"
    [[ ! -L "$LAYOUT_FILE" ]] || die "Managed image layout must not be a symbolic link: $LAYOUT_FILE"
    # shellcheck disable=SC1090
    source "$LAYOUT_FILE"

    [[ -n "$ROOT_UUID" ]] || die "ROOT_UUID is missing from $LAYOUT_FILE"
    [[ -n "$BOOT_UUID" ]] || die "BOOT_UUID is missing from $LAYOUT_FILE"
    [[ -n "$EXTLINUX_REL" ]] || die "EXTLINUX_REL is missing from $LAYOUT_FILE"
    [[ "$SAME_FS" == "1" ]] ||
        die "This image installer expects the managed root and extlinux payload on the same filesystem."
    [[ "$EXTLINUX_REL" == "$EXPECTED_EXTLINUX_REL" ]] ||
        die "Unexpected extlinux location: $EXTLINUX_REL"
    [[ "$ROOT_UUID" == "$BOOT_UUID" ]] ||
        die "Managed same-filesystem layout has different root and boot UUIDs."
}

discover_source() {
    local highest_part parent_name part_num root_source root_fstype start_value

    root_source="$(findmnt -nro SOURCE --target /)"
    [[ -n "$root_source" ]] || die "Unable to identify the mounted root source."
    SOURCE_ROOT_PART="$(readlink -f -- "$root_source")"
    [[ -b "$SOURCE_ROOT_PART" ]] || die "Root source is not a block device: $root_source"

    root_fstype="$(findmnt -nro FSTYPE --target /)"
    [[ "$root_fstype" == "ext4" ]] || die "The managed root filesystem must be ext4, found: $root_fstype"

    part_num="$(lsblk -nro PARTN "$SOURCE_ROOT_PART" | head -n 1 | tr -d '[:space:]')"
    [[ "$part_num" == "3" ]] ||
        die "Expected the running Cubie A5E root filesystem on partition 3; found partition ${part_num:-unknown}."

    parent_name="$(lsblk -nro PKNAME "$SOURCE_ROOT_PART" | head -n 1 | tr -d '[:space:]')"
    [[ -n "$parent_name" ]] || die "Unable to identify the parent disk for $SOURCE_ROOT_PART"
    SOURCE_DISK="/dev/$parent_name"
    [[ -b "$SOURCE_DISK" ]] || die "Source disk is unavailable: $SOURCE_DISK"

    case "$SOURCE_DISK" in
        /dev/nvme*n*) die "The running system is already on NVMe: $SOURCE_DISK" ;;
    esac

    SOURCE_ROOT_UUID="$(blkid -s UUID -o value "$SOURCE_ROOT_PART")"
    [[ -n "$SOURCE_ROOT_UUID" ]] || die "Unable to read the running root filesystem UUID."
    [[ "$SOURCE_ROOT_UUID" == "$ROOT_UUID" ]] ||
        die "Running root UUID does not match the managed image layout."

    SOURCE_DISK_SIZE="$(blockdev --getsize64 "$SOURCE_DISK")"
    SOURCE_SECTOR_SIZE="$(blockdev --getss "$SOURCE_DISK")"
    [[ "$SOURCE_DISK_SIZE" =~ ^[0-9]+$ && "$SOURCE_DISK_SIZE" -gt 0 ]] ||
        die "Unable to determine source disk size."
    [[ "$SOURCE_SECTOR_SIZE" =~ ^[0-9]+$ && "$SOURCE_SECTOR_SIZE" -gt 0 ]] ||
        die "Unable to determine source logical sector size."

    start_value="$(
        parted -ms "$SOURCE_DISK" unit s print |
            awk -F: '$1 == "3" { gsub(/s$/, "", $2); print $2; exit }'
    )"
    [[ "$start_value" =~ ^[0-9]+$ && "$start_value" -gt 0 ]] ||
        die "Unable to determine partition-3 start sector on $SOURCE_DISK"

    SOURCE_ROOT_START_SECTOR="$start_value"
    SOURCE_ROOT_START_BYTES=$((SOURCE_ROOT_START_SECTOR * SOURCE_SECTOR_SIZE))

    sgdisk -v "$SOURCE_DISK" >/dev/null 2>&1 || die "Source GPT validation failed on $SOURCE_DISK"
    sgdisk -i 3 "$SOURCE_DISK" >/dev/null 2>&1 || die "Source GPT does not contain the expected partition 3."

    highest_part="$(
        lsblk -nr -o TYPE,PARTN "$SOURCE_DISK" |
            awk '$1 == "part" && ($2 + 0) > highest { highest = $2 + 0 } END { print highest + 0 }'
    )"
    [[ "$highest_part" == "3" ]] ||
        die "Expected partition 3 to be the final source partition; found final partition $highest_part."
}

validate_runtime_root_layout() {
    local root="$1" label="$2" directory path tmp_mode

    root="${root%/}"
    [[ -n "$root" ]] || root="/"

    for directory in dev proc sys run tmp mnt media; do
        if [[ "$root" == "/" ]]; then
            path="/$directory"
        else
            path="$root/$directory"
        fi
        [[ -d "$path" ]] || die "$label root filesystem is missing required runtime directory: /$directory"
    done

    if [[ "$root" == "/" ]]; then
        tmp_mode="$(stat -c '%a' /tmp)"
        [[ -x /sbin/init ]] || die "$label root filesystem lacks executable /sbin/init."
        [[ -x /usr/lib/systemd/systemd ]] || die "$label root filesystem lacks executable /usr/lib/systemd/systemd."
    else
        tmp_mode="$(stat -c '%a' "$root/tmp")"
        [[ -x "$root/sbin/init" ]] || die "$label root filesystem lacks executable /sbin/init."
        [[ -x "$root/usr/lib/systemd/systemd" ]] || die "$label root filesystem lacks executable /usr/lib/systemd/systemd."
    fi

    [[ "$tmp_mode" == "1777" ]] || die "$label /tmp mode is $tmp_mode; expected 1777."
}

normalize_target_runtime_layout() {
    install -d -m 0755 -- \
        "$TARGET_ROOT_MNT/dev" \
        "$TARGET_ROOT_MNT/proc" \
        "$TARGET_ROOT_MNT/sys" \
        "$TARGET_ROOT_MNT/run" \
        "$TARGET_ROOT_MNT/mnt" \
        "$TARGET_ROOT_MNT/media"
    install -d -m 1777 -- "$TARGET_ROOT_MNT/tmp"
}

validate_source_spi_dtb() {
    local active_kernel dtb frequency

    active_kernel="$(uname -r)"
    dtb="/usr/lib/linux-image-$active_kernel/allwinner/sun55i-a527-cubie-a5e.dtb"
    [[ -s "$dtb" ]] || die "Running managed Cubie A5E DTB is missing for SPI validation: $dtb"

    frequency="$(fdtget -t u "$dtb" /soc/spi@4025000/flash@0 spi-max-frequency 2>/dev/null || true)"
    [[ "$frequency" == "$EXPECTED_SPI_FREQUENCY" ]] ||
        die "Running DTB SPI-NOR frequency is ${frequency:-missing}; expected field-validated ${EXPECTED_SPI_FREQUENCY} Hz."
}

validate_source_runtime() {
    local active_kernel extlinux

    active_kernel="$(uname -r)"
    extlinux="/$EXTLINUX_REL"
    [[ -n "$active_kernel" ]] || die "Unable to identify the running kernel release."
    [[ -s "$extlinux" ]] || die "Managed source extlinux configuration is missing: $extlinux"
    [[ -s "/boot/vmlinuz-$active_kernel" ]] || die "Running managed kernel image is missing from /boot: $active_kernel"
    [[ -s "/boot/initrd.img-$active_kernel" ]] || die "Running managed initramfs is missing from /boot: $active_kernel"
    [[ -s "/usr/lib/linux-image-$active_kernel/allwinner/sun55i-a527-cubie-a5e.dtb" ]] ||
        die "Running managed Cubie A5E DTB is missing for $active_kernel"

    grep -Fxq 'default cubie-a5e' "$extlinux" || die "Source extlinux default is not cubie-a5e."
    grep -Fxq 'label cubie-a5e' "$extlinux" || die "Source managed extlinux entry is missing."
    grep -Fq "linux /boot/vmlinuz-$active_kernel" "$extlinux" || die "Source extlinux does not reference the running managed kernel."
    grep -Fq "initrd /boot/initrd.img-$active_kernel" "$extlinux" || die "Source extlinux does not reference the running managed initramfs."
    grep -Fq "fdtdir /usr/lib/linux-image-$active_kernel/" "$extlinux" || die "Source extlinux does not reference the running managed DTB directory."
    grep -Eq "^[[:space:]]*append[[:space:]].*root=UUID=${SOURCE_ROOT_UUID}([[:space:]]|$)" "$extlinux" ||
        die "Source extlinux does not reference the mounted root UUID."

    [[ -s /etc/fstab ]] || die "Source /etc/fstab is missing."
    grep -Eq "^UUID=${SOURCE_ROOT_UUID}[[:space:]]+/[[:space:]]+ext4[[:space:]]" /etc/fstab ||
        die "Source /etc/fstab does not reference the mounted root UUID."
    [[ -s /etc/initramfs-tools/modules ]] || die "Source initramfs module policy is missing."
    grep -Fxq 'phy-sunxi-inno-combophy' /etc/initramfs-tools/modules || die "Source initramfs policy lacks phy-sunxi-inno-combophy."
    grep -Fxq 'pcie_sunxi_host' /etc/initramfs-tools/modules || die "Source initramfs policy lacks pcie_sunxi_host."

    validate_runtime_root_layout "/" "Source"
    validate_source_spi_dtb
    [[ ! -e /var/lib/cubie-a5e-update/pending.env ]] ||
        die "A managed kernel/board update is pending. Reboot/finalize it before NVMe migration."
}

validate_spi_bootloader() {
    local aw2501_version board_version expected_marker

    [[ -c "$SPI_MTD_DEVICE" ]] ||
        die "SPI NOR device $SPI_MTD_DEVICE is unavailable. The image must expose the 16 MiB Cubie A5E SPI NOR before NVMe migration."
    [[ -x /usr/sbin/flashcp ]] || die "mtd-utils flashcp is missing."
    [[ -x /usr/sbin/flash_erase ]] || die "mtd-utils flash_erase is missing."
    [[ -x "$RADXA_UBOOT_PAYLOAD_DIR/setup.sh" ]] ||
        die "Radxa Cubie A5E SPI update backend is missing: $RADXA_UBOOT_PAYLOAD_DIR/setup.sh"

    aw2501_version="$(dpkg-query -W -f='${Version}' u-boot-aw2501 2>/dev/null || true)"
    board_version="$(dpkg-query -W -f='${Version}' u-boot-radxa-cubie-a5e 2>/dev/null || true)"
    [[ -n "$aw2501_version" ]] || die "u-boot-aw2501 is not installed."
    [[ -n "$board_version" ]] || die "u-boot-radxa-cubie-a5e is not installed."
    [[ "$aw2501_version" == "$board_version" ]] ||
        die "Radxa U-Boot package versions differ: aw2501=$aw2501_version board=$board_version"
    dpkg --compare-versions "$aw2501_version" ge "$MINIMUM_UBOOT_VERSION" ||
        die "Installed Radxa U-Boot $aw2501_version is older than the validated minimum $MINIMUM_UBOOT_VERSION."

    expected_marker="U-Boot ${aw2501_version}-boot-aw2501-"
    if ! dd if="$SPI_MTD_DEVICE" bs=1M count=2 status=none 2>/dev/null |
        strings |
        grep -F -- "$expected_marker" >/dev/null; then
        die "On-board SPI firmware does not contain the installed Cubie A5E U-Boot $aw2501_version. Update the SPI bootloader through rsetup before NVMe migration."
    fi

    log "Validated on-board SPI U-Boot $aw2501_version for standalone NVMe boot."
}

candidate_nvme_disks() {
    local disk read_only type

    while IFS= read -r disk; do
        [[ -b "$disk" ]] || continue
        case "$disk" in
            /dev/nvme[0-9]*n[0-9]*) ;;
            *) continue ;;
        esac
        type="$(lsblk -dnro TYPE "$disk" | tr -d '[:space:]')"
        read_only="$(lsblk -dnro RO "$disk" | tr -d '[:space:]')"
        [[ "$type" == "disk" && "$read_only" == "0" ]] || continue
        [[ "$(readlink -f -- "$disk")" != "$(readlink -f -- "$SOURCE_DISK")" ]] || continue
        printf '%s\n' "$disk"
    done < <(lsblk -dnpro NAME)
}

disk_description() {
    local disk="$1" model serial size

    size="$(lsblk -dnro SIZE "$disk" | xargs)"
    model="$(lsblk -dnro MODEL "$disk" | xargs)"
    serial="$(lsblk -dnro SERIAL "$disk" | xargs)"
    [[ -n "$model" ]] || model="unknown-model"
    [[ -n "$serial" ]] || serial="no-serial"
    printf '%s | %s | %s\n' "$size" "$model" "$serial"
}

list_targets() {
    local disk found=0

    discover_source
    while IFS= read -r disk; do
        [[ -n "$disk" ]] || continue
        found=1
        printf '%s\t%s\n' "$disk" "$(disk_description "$disk")"
    done < <(candidate_nvme_disks)
    ((found == 1)) || return 1
}

select_target_tui() {
    local disk selected
    local -a menu_items=()

    while IFS= read -r disk; do
        [[ -n "$disk" ]] || continue
        menu_items+=("$disk" "$(disk_description "$disk")")
    done < <(candidate_nvme_disks)
    ((${#menu_items[@]} > 0)) || die "No writable NVMe namespace is available."

    selected="$(
        whiptail \
            --title "Cubie A5E NVMe installer" \
            --menu "Select the NVMe device to ERASE and install the current system onto:" \
            18 92 8 \
            "${menu_items[@]}" \
            3>&1 1>&2 2>&3
    )" || exit 0
    REQUESTED_TARGET="$selected"
}

validate_target() {
    local child mounted_target swap_name

    [[ -n "$REQUESTED_TARGET" ]] || die "No NVMe target was selected."
    TARGET_DISK="$(readlink -f -- "$REQUESTED_TARGET")"
    case "$TARGET_DISK" in
        /dev/nvme[0-9]*n[0-9]*) ;;
        *) die "Target must be a whole NVMe namespace, for example /dev/nvme0n1: $REQUESTED_TARGET" ;;
    esac

    [[ -b "$TARGET_DISK" ]] || die "NVMe target is not a block device: $TARGET_DISK"
    [[ "$(lsblk -dnro TYPE "$TARGET_DISK" | tr -d '[:space:]')" == "disk" ]] || die "Target is not a whole disk: $TARGET_DISK"
    [[ "$(lsblk -dnro RO "$TARGET_DISK" | tr -d '[:space:]')" == "0" ]] || die "Target NVMe is read-only: $TARGET_DISK"
    [[ "$(readlink -f -- "$TARGET_DISK")" != "$(readlink -f -- "$SOURCE_DISK")" ]] || die "Refusing to overwrite the running source disk."

    TARGET_DISK_SIZE="$(blockdev --getsize64 "$TARGET_DISK")"
    TARGET_SECTOR_SIZE="$(blockdev --getss "$TARGET_DISK")"
    [[ "$TARGET_DISK_SIZE" =~ ^[0-9]+$ && "$TARGET_DISK_SIZE" -gt 0 ]] || die "Unable to determine target disk size."
    [[ "$TARGET_SECTOR_SIZE" == "$SOURCE_SECTOR_SIZE" ]] ||
        die "Source and target logical sector sizes differ: source=$SOURCE_SECTOR_SIZE target=$TARGET_SECTOR_SIZE"
    ((TARGET_DISK_SIZE >= SOURCE_DISK_SIZE)) ||
        die "For this guarded installer the NVMe must be at least as large as the source media. source=$SOURCE_DISK_SIZE target=$TARGET_DISK_SIZE"

    while IFS= read -r child; do
        [[ -n "$child" ]] || continue
        mounted_target="$(findmnt -rn -S "$child" -o TARGET 2>/dev/null | head -n 1 || true)"
        [[ -z "$mounted_target" ]] || die "Target device has a mounted filesystem: $child at $mounted_target"
        while IFS= read -r swap_name; do
            [[ -n "$swap_name" ]] || continue
            [[ "$(readlink -f -- "$swap_name")" != "$(readlink -f -- "$child")" ]] ||
                die "Target device is active swap: $child"
        done < <(swapon --show=NAME --noheadings 2>/dev/null || true)
    done < <(lsblk -nrpo NAME "$TARGET_DISK")
}

show_install_summary() {
    printf '\n'
    log "Running source: $SOURCE_DISK ($SOURCE_ROOT_PART, UUID=$SOURCE_ROOT_UUID)"
    log "Destructive target: $TARGET_DISK ($(disk_description "$TARGET_DISK"))"
    log "The Radxa boot-chain area before partition 3 will be cloned from the source media."
    log "Partition 3 will be recreated to fill the NVMe and populated from the running Debian system."
    warn "ALL EXISTING DATA ON $TARGET_DISK WILL BE DESTROYED."
    warn "Standalone NVMe boot requires compatible Cubie A5E SPI boot firmware."
}

confirm_target() {
    local expected typed

    expected="$(basename -- "$TARGET_DISK")"
    if ((TUI_MODE == 1)); then
        whiptail \
            --title "ERASE NVMe" \
            --yesno "ALL DATA on $TARGET_DISK will be destroyed.\n\n$(disk_description "$TARGET_DISK")\n\nContinue?" \
            14 86 || exit 0
        typed="$(
            whiptail \
                --title "Final destructive confirmation" \
                --inputbox "Type exactly $expected to erase $TARGET_DISK:" \
                10 76 \
                3>&1 1>&2 2>&3
        )" || exit 0
        [[ "$typed" == "$expected" ]] || die "Confirmation text did not match $expected."
        return 0
    fi

    printf 'Type exactly ERASE %s to continue: ' "$TARGET_DISK" >&2
    IFS= read -r typed
    [[ "$typed" == "ERASE $TARGET_DISK" ]] || die "Confirmation not given."
}

acquire_lock() {
    install -d -m 0755 -- "$(dirname -- "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Another Cubie A5E NVMe installation is already running."
    exec 8>"$UPDATE_LOCK_FILE"
    flock -n 8 || die "A Cubie A5E kernel/board update is currently running. Finish it before NVMe migration."
}

prepare_target_partition_table() {
    log "Synchronizing the running source filesystem before the destructive copy."
    sync

    log "Clearing old partition metadata on $TARGET_DISK."
    wipefs -a -f "$TARGET_DISK"
    sgdisk --zap-all "$TARGET_DISK" >/dev/null

    log "Cloning the official Radxa boot-chain area before partition 3."
    dd \
        if="$SOURCE_DISK" \
        of="$TARGET_DISK" \
        bs=4M \
        count="$SOURCE_ROOT_START_BYTES" \
        iflag=count_bytes \
        conv=fsync \
        status=progress

    log "Relocating the backup GPT and expanding partition 3 to the NVMe capacity."
    sgdisk -e "$TARGET_DISK" >/dev/null
    sgdisk -d 3 "$TARGET_DISK" >/dev/null
    sgdisk \
        -n "3:${SOURCE_ROOT_START_SECTOR}:0" \
        -t 3:8300 \
        -c 3:rootfs \
        "$TARGET_DISK" >/dev/null

    # Radxa SPI U-Boot scans bootable GPT partitions. Recreating partition 3
    # clears the donor's legacy bootable attribute, so restore GPT attribute
    # bit 2 explicitly before regenerating target GUIDs.
    sgdisk -A 3:set:2 "$TARGET_DISK" >/dev/null
    sgdisk -G "$TARGET_DISK" >/dev/null
    sgdisk -v "$TARGET_DISK" >/dev/null 2>&1 || die "Target GPT validation failed after recreation."
    sgdisk -i 3 "$TARGET_DISK" |
        grep -E '^Attribute flags:[[:space:]]+[0-9A-Fa-f]{15}[4567cCdDeEfF]$' >/dev/null ||
        die "Target partition 3 is missing the GPT legacy bootable attribute required by SPI U-Boot."

    partprobe "$TARGET_DISK"
    udevadm settle
    TARGET_ROOT_PART="$(partition_path "$TARGET_DISK" 3)"
    [[ -b "$TARGET_ROOT_PART" ]] || die "Target root partition did not appear: $TARGET_ROOT_PART"
    [[ "$(
        parted -ms "$TARGET_DISK" unit s print |
            awk -F: '$1 == "3" { gsub(/s$/, "", $2); print $2; exit }'
    )" == "$SOURCE_ROOT_START_SECTOR" ]] || die "Target partition 3 does not start at the source partition-3 offset."
}

format_target_root() {
    log "Creating a fresh ext4 root filesystem on $TARGET_ROOT_PART."
    mkfs.ext4 -F -L rootfs -U random "$TARGET_ROOT_PART" >/dev/null
    udevadm settle
    TARGET_ROOT_UUID="$(blkid -s UUID -o value "$TARGET_ROOT_PART")"
    [[ -n "$TARGET_ROOT_UUID" ]] || die "Unable to read the new NVMe root UUID."
    [[ "$TARGET_ROOT_UUID" != "$SOURCE_ROOT_UUID" ]] || die "NVMe root UUID unexpectedly matches the source UUID."
}

mount_target_root() {
    install -d -m 0755 -- "$TARGET_ROOT_MNT"
    mount "$TARGET_ROOT_PART" "$TARGET_ROOT_MNT"
    TARGET_ROOT_MOUNTED=1
}

rsync_root_pass() {
    rsync \
        -aHAXx \
        --numeric-ids \
        --delete-delay \
        --info=progress2 \
        --exclude='/dev/*' \
        --exclude='/proc/*' \
        --exclude='/run/*' \
        --exclude='/sys/*' \
        --exclude='/tmp/*' \
        --exclude='/mnt/*' \
        --exclude='/media/*' \
        --exclude='/lost+found' \
        / \
        "$TARGET_ROOT_MNT/"
}

copy_running_system() {
    log "Copying the running Debian system to NVMe (pass 1 of 2)."
    rsync_root_pass
    sync
    log "Refreshing changed files on NVMe (pass 2 of 2)."
    rsync_root_pass
    normalize_target_runtime_layout
    sync
}

rewrite_target_fstab() {
    local fstab="$TARGET_ROOT_MNT/etc/fstab" temporary root_entry_count

    [[ -s "$fstab" ]] || die "Target /etc/fstab is missing after copy."
    temporary="$(mktemp "$TARGET_ROOT_MNT/etc/.fstab.nvme.XXXXXX")"
    awk -v uuid="$TARGET_ROOT_UUID" '
        BEGIN { OFS = " " }
        /^[[:space:]]*#/ || NF == 0 { print; next }
        $2 == "/" { $1 = "UUID=" uuid; root_count++ }
        { print }
        END { if (root_count != 1) exit 42 }
    ' "$fstab" >"$temporary" || {
        rm -f -- "$temporary"
        die "Expected exactly one root filesystem entry in target /etc/fstab."
    }

    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$fstab"
    root_entry_count="$(awk '$2 == "/" { count++ } END { print count + 0 }' "$fstab")"
    [[ "$root_entry_count" == "1" ]] || die "Target /etc/fstab root entry validation failed."
    grep -Eq "^UUID=${TARGET_ROOT_UUID}[[:space:]]+/[[:space:]]+ext4[[:space:]]" "$fstab" ||
        die "Target /etc/fstab does not reference the new NVMe root UUID."
}

rewrite_target_extlinux() {
    local extlinux="$TARGET_ROOT_MNT/$EXTLINUX_REL" temporary

    [[ -s "$extlinux" ]] || die "Target extlinux configuration is missing: /$EXTLINUX_REL"
    temporary="$(mktemp "$(dirname -- "$extlinux")/.extlinux.conf.nvme.XXXXXX")"
    sed -E \
        "s#(^|[[:space:]])root=UUID=[^[:space:]]+#\\1root=UUID=${TARGET_ROOT_UUID}#g" \
        "$extlinux" >"$temporary"
    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$extlinux"

    grep -Eq "^[[:space:]]*append[[:space:]].*root=UUID=${TARGET_ROOT_UUID}([[:space:]]|$)" "$extlinux" ||
        die "Target extlinux does not reference the new NVMe root UUID."
    [[ "$(grep -Eo 'root=UUID=[^[:space:]]+' "$extlinux" | sort -u | wc -l | tr -d '[:space:]')" == "1" ]] ||
        die "Target extlinux contains multiple root UUID values."
}

rewrite_target_layout() {
    local layout="$TARGET_ROOT_MNT$LAYOUT_FILE" temporary

    install -d -m 0755 -- "$(dirname -- "$layout")"
    temporary="$(mktemp "$(dirname -- "$layout")/.layout.env.nvme.XXXXXX")"
    {
        printf 'ROOT_UUID=%q\n' "$TARGET_ROOT_UUID"
        printf 'BOOT_UUID=%q\n' "$TARGET_ROOT_UUID"
        printf 'EXTLINUX_REL=%q\n' "$EXTLINUX_REL"
        printf 'SAME_FS=1\n'
    } >"$temporary"
    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$layout"
}

write_target_markers() {
    local grow_marker="$TARGET_ROOT_MNT$ROOT_GROW_MARKER_REL"
    local status_file="$TARGET_ROOT_MNT$STATUS_FILE_REL"
    local target_root_size

    target_root_size="$(blockdev --getsize64 "$TARGET_ROOT_PART")"
    install -d -m 0755 -- "$(dirname -- "$grow_marker")" "$(dirname -- "$status_file")"

    {
        printf 'completed_utc=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        printf 'disk=%s\n' "$TARGET_DISK"
        printf 'root_partition=%s\n' "$TARGET_ROOT_PART"
        printf 'disk_size_bytes=%s\n' "$TARGET_DISK_SIZE"
        printf 'partition_size_before_bytes=%s\n' "$target_root_size"
        printf 'partition_size_after_bytes=%s\n' "$target_root_size"
    } >"$grow_marker"
    chmod 0644 "$grow_marker"

    {
        printf 'STATUS=PASS\n'
        printf 'INSTALLED_UTC=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        printf 'SOURCE_DISK=%q\n' "$SOURCE_DISK"
        printf 'SOURCE_ROOT_UUID=%q\n' "$SOURCE_ROOT_UUID"
        printf 'TARGET_DISK=%q\n' "$TARGET_DISK"
        printf 'TARGET_ROOT_UUID=%q\n' "$TARGET_ROOT_UUID"
    } >"$status_file"
    chmod 0644 "$status_file"
}

validate_target_filesystem() {
    local active_kernel extlinux target_layout frequency

    active_kernel="$(uname -r)"
    extlinux="$TARGET_ROOT_MNT/$EXTLINUX_REL"
    target_layout="$TARGET_ROOT_MNT$LAYOUT_FILE"

    [[ -s "$TARGET_ROOT_MNT/boot/vmlinuz-$active_kernel" ]] || die "Target kernel image is missing: /boot/vmlinuz-$active_kernel"
    [[ -s "$TARGET_ROOT_MNT/boot/initrd.img-$active_kernel" ]] || die "Target initramfs is missing: /boot/initrd.img-$active_kernel"
    [[ -s "$TARGET_ROOT_MNT/usr/lib/linux-image-$active_kernel/allwinner/sun55i-a527-cubie-a5e.dtb" ]] ||
        die "Target Cubie A5E DTB is missing for $active_kernel"

    frequency="$(fdtget -t u \
        "$TARGET_ROOT_MNT/usr/lib/linux-image-$active_kernel/allwinner/sun55i-a527-cubie-a5e.dtb" \
        /soc/spi@4025000/flash@0 spi-max-frequency 2>/dev/null || true)"
    [[ "$frequency" == "$EXPECTED_SPI_FREQUENCY" ]] ||
        die "Target DTB does not retain the field-validated 20 MHz SPI-NOR frequency."

    validate_runtime_root_layout "$TARGET_ROOT_MNT" "Target"
    grep -Fxq 'default cubie-a5e' "$extlinux" || die "Target extlinux default is not cubie-a5e."
    grep -Fxq 'label cubie-a5e' "$extlinux" || die "Target managed extlinux entry is missing."
    grep -Fq "linux /boot/vmlinuz-$active_kernel" "$extlinux" || die "Target extlinux kernel path does not match the running managed kernel."
    grep -Fq "initrd /boot/initrd.img-$active_kernel" "$extlinux" || die "Target extlinux initramfs path does not match the running managed kernel."
    grep -Fq "fdtdir /usr/lib/linux-image-$active_kernel/" "$extlinux" || die "Target extlinux DTB directory does not match the running managed kernel."

    grep -Fxq "ROOT_UUID=$TARGET_ROOT_UUID" "$target_layout" || die "Target update layout has the wrong root UUID."
    grep -Fxq "BOOT_UUID=$TARGET_ROOT_UUID" "$target_layout" || die "Target update layout has the wrong boot UUID."
    grep -Fxq "EXTLINUX_REL=$EXTLINUX_REL" "$target_layout" || die "Target update layout has the wrong extlinux path."
    grep -Fxq 'SAME_FS=1' "$target_layout" || die "Target update layout has the wrong filesystem relationship."
    grep -Fxq 'phy-sunxi-inno-combophy' "$TARGET_ROOT_MNT/etc/initramfs-tools/modules" || die "Target initramfs policy lacks phy-sunxi-inno-combophy."
    grep -Fxq 'pcie_sunxi_host' "$TARGET_ROOT_MNT/etc/initramfs-tools/modules" || die "Target initramfs policy lacks pcie_sunxi_host."

    if grep -Eq "(^|[[:space:]])root=UUID=${SOURCE_ROOT_UUID}([[:space:]]|$)" "$extlinux"; then
        die "Target extlinux still references the source root UUID."
    fi
    if grep -Eq "^UUID=${SOURCE_ROOT_UUID}[[:space:]]+/[[:space:]]" "$TARGET_ROOT_MNT/etc/fstab"; then
        die "Target /etc/fstab still references the source root UUID."
    fi
}

finish_target() {
    local status

    log "Flushing NVMe filesystem data."
    sync
    umount "$TARGET_ROOT_MNT"
    TARGET_ROOT_MOUNTED=0

    log "Running read-only ext4 verification on $TARGET_ROOT_PART."
    e2fsck -fn "$TARGET_ROOT_PART" >/dev/null || {
        status=$?
        case "$status" in
            1) ;;
            *) die "Read-only ext4 verification failed with status $status." ;;
        esac
    }

    sgdisk -v "$TARGET_DISK" >/dev/null 2>&1 || die "Final target GPT validation failed."
    sync
}

show_success() {
    local message

    message="NVMe installation completed successfully.\n\nTarget: $TARGET_DISK\nRoot UUID: $TARGET_ROOT_UUID\n\nThe running 20 MHz SPI-NOR DTB and on-board Radxa SPI U-Boot were validated before installation.\n\nPower the Cubie A5E off completely, remove the microSD card, then boot again."
    log "NVMe installation completed successfully."
    log "Target: $TARGET_DISK"
    log "NVMe root UUID: $TARGET_ROOT_UUID"
    log "SPI/U-Boot preflight: PASS"
    log "Next: power off, remove the microSD card, and boot again."

    if ((TUI_MODE == 1)); then
        whiptail --title "Cubie A5E NVMe installer" --msgbox "$message" 18 86
    fi
}

install_to_nvme() {
    load_managed_layout
    discover_source
    validate_source_runtime
    validate_spi_bootloader

    if ((TUI_MODE == 1)); then
        select_target_tui
    fi

    validate_target
    show_install_summary
    confirm_target
    acquire_lock

    install -d -m 0755 -- "$WORK_DIR"
    prepare_target_partition_table
    format_target_root
    mount_target_root
    copy_running_system
    rewrite_target_fstab
    rewrite_target_extlinux
    rewrite_target_layout
    validate_target_filesystem
    write_target_markers
    finish_target
    show_success
}

main() {
    local command_name
    local required_commands=(
        awk basename blkid blockdev chmod date dd dirname dpkg dpkg-query
        e2fsck fdtget findmnt flock grep head install lsblk mkfs.ext4 mktemp
        mount mountpoint mv parted partprobe readlink rm rsync sed sgdisk sort
        stat strings swapon sync tr udevadm umount uname wc whiptail wipefs xargs
    )

    case "${1:-}" in
        --self-test)
            (($# == 1)) || { usage >&2; exit 2; }
            self_test
            return
            ;;
        --list-targets)
            (($# == 1)) || { usage >&2; exit 2; }
            ((EUID == 0)) || die "Run --list-targets as root."
            for command_name in "${required_commands[@]}"; do
                need_cmd "$command_name"
            done
            load_managed_layout
            list_targets
            return
            ;;
        --tui)
            (($# == 1)) || { usage >&2; exit 2; }
            TUI_MODE=1
            ;;
        --target)
            (($# == 2)) || { usage >&2; exit 2; }
            REQUESTED_TARGET="$2"
            ;;
        -h | --help)
            usage
            return
            ;;
        "")
            TUI_MODE=1
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac

    if ((EUID != 0)); then
        command -v sudo >/dev/null 2>&1 || die "sudo is required when running as a non-root user."
        exec sudo "$0" "$@"
    fi

    for command_name in "${required_commands[@]}"; do
        need_cmd "$command_name"
    done

    install_to_nvme
}

main "$@"
